# ============================================================================
# AIRFLOW — Environment variables
# Copy this file to `.env.local` and fill in real values for the services you
# use. Any service whose vars are missing falls back to mock data automatically.
# ============================================================================

# --- Supabase (DB + Auth) -----------------------------------------------------
# Free tier: https://supabase.com  →  New project  →  Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role: Settings → API → service_role (server-only — never expose)
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (Payments) --------------------------------------------------------
# Test keys: https://dashboard.stripe.com/test/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=

# --- Resend (Booking confirmation emails) -------------------------------------
# Free 3k/mo: https://resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM_EMAIL=Airflow <bookings@yourdomain.com>

# --- OpenSky Network (Real live aircraft data) --------------------------------
# Optional — public endpoints work without auth (rate-limited to 10/min anon).
# For higher limits, sign up at https://opensky-network.org/index.php
OPENSKY_USERNAME=
OPENSKY_PASSWORD=

# --- App config ---------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
