<?xml version="1.0" encoding="utf-8"?>
<!-- API 21+ launch screen. `?android:colorBackground` follows the system
     light/dark setting, so the splash matches the theme the app is about to
     render in rather than flashing the opposite one. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="?android:colorBackground" />
    <item
        android:width="96dp"
        android:height="96dp"
        android:gravity="center"
        android:drawable="@drawable/splash_plane" />
</layer-list>
